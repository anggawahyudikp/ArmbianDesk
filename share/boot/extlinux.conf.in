LABEL ArmbianDesk
  LINUX /Image
  INITRD /uInitrd
  FDT /dtb/@DTB_RELPATH@
  APPEND root=LABEL=ARMBIAN_ROOT rootwait rootfstype=ext4 rootflags=data=writeback rw console=ttyAML0,115200n8 console=tty0 no_console_suspend consoleblank=0 fsck.fix=yes fsck.repair=yes net.ifnames=0 quiet loglevel=3 cma=@CMA_MB@M
